# ── Red Seal Rescue · Stripe Connect sample ─────────────────────────────
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#
# Find your keys in the Stripe Dashboard:  https://dashboard.stripe.com/test/apikeys
# Use TEST-mode keys (they start with sk_test_ / pk_test_) for this sample.

# REQUIRED — your platform's secret API key. The server refuses to start without it.
# Placeholder below is intentionally invalid so you don't accidentally run with it.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# REQUIRED FOR WEBHOOKS ONLY — the signing secret for your webhook endpoint.
# When testing locally with the Stripe CLI, run `stripe listen ...` (see README)
# and it prints a secret like "whsec_...". Paste it here.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# OPTIONAL — where this server is reachable. Used to build onboarding return URLs
# and Checkout success/cancel URLs. Defaults to http://localhost:4242.
ROOT_URL=http://localhost:4242

# OPTIONAL — port to listen on. Defaults to 4242.
PORT=4242

# OPTIONAL — the platform fee taken on each sale, as a percentage of the price.
# 10 means the platform keeps 10% and the coach (connected account) gets 90%.
PLATFORM_FEE_PERCENT=10
